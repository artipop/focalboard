              class="CompassIcon icon-magnify MagnifyIcon"
            />
            <div
              class="Combobox userSearchInput"
            >
              <span
                aria-atomic="false"
                aria-live="polite"
                aria-relevant="additions text"
                class="Combobox__live-region"
                role="log"
              />
