# Fail loudly when the toolchain doesn't match `engines` in package.json instead of
# silently resolving (and rewriting package-lock.json) on a different npm.
engine-strict=true

# npm 11 blocks dependency install scripts by default. Only cypress genuinely needs its
# postinstall (it downloads the test-runner binary); the other pending scripts
# (@swc/core, core-js, core-js-pure, gifsicle, cwebp-bin, @parcel/watcher) are not
# required -- pack/test/check all pass without them, and prebuilt native packages cover
# @swc/core and @parcel/watcher. Keep this list minimal; run `npm approve-scripts` to review.
allow-scripts[]=cypress
