build/bin/
frontend/node_modules/
# generated by `wails dev`; unused by the webapp (it calls window.go.main.App.* via the
# injected runtime) and not needed for release builds, which pass -skipbindings.
# The frontend/ directory itself must exist on a clean clone or `wails build` fails,
# hence frontend/.gitkeep.
frontend/wailsjs/
frontend/dist/
# stray binary from `go build ./...` in the module dir
/desktop
